# ── Student Copilot AI Configuration ─────────────────────────────────────────

# Set MOCK_MODE=false to enable live Gnani Voice and LLM reasoning.
# In MOCK_MODE=true, all 12 modules function with rich synthetic responses.
MOCK_MODE=true

# ── Gnani.ai Voice APIs ──────────────────────────────────────────────────────
# Enter your Gnani API key from the Gnani dashboard (https://api.vachana.ai)
# This powers:
#   1. Prisma STT: POST /stt/v3 (multilingual code-mixed Telugu, Hindi, English, etc.)
#   2. Timbre TTS: POST /api/v1/tts/inference (Vasudha voice v3.0 with Varuni v2.5 fallback)
GNANI_API_KEY=
GNANI_BASE_URL=https://api.vachana.ai

# ── LLM Tutor & Reasoning (GroqCloud / Gemini / Anthropic) ────────────────────
# Options: groq | gemini | anthropic | mock
#
# RECOMMENDED (FREE & ULTRA-FAST): GroqCloud (https://console.groq.com/keys)
# Free API key, 500+ tokens/sec, near-instant voice replies:
#   LLM_PROVIDER=groq
#   GROQ_API_KEY=gsk_your_groq_api_key_here
#   GROQ_MODEL=llama-3.3-70b-versatile
#
# Alternative: Google Gemini
#   LLM_PROVIDER=gemini
#   GEMINI_API_KEY=your_gemini_api_key_here
#   LLM_MODEL=gemini-2.0-flash
#
# Alternative: Anthropic Claude
#   LLM_PROVIDER=anthropic
#   ANTHROPIC_API_KEY=your_anthropic_api_key_here
#   LLM_MODEL=claude-3-5-sonnet-20241022

LLM_PROVIDER=groq
GROQ_API_KEY=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
GROQ_MODEL=llama-3.3-70b-versatile

GEMINI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=

# ── Security & Session ────────────────────────────────────────────────────────
# Optional demo access token to gate public instances
DEMO_TOKEN=
# Session TTL in seconds (default: 3600 = 1 hour, in-memory, zero disk storage of audio)
SESSION_TTL_SECONDS=3600
